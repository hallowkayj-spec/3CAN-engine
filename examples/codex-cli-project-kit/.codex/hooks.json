{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/3can_research_harness.py hook",
            "timeout": 10,
            "statusMessage": "Checking 3CAN research gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/3can_pr_harness.py hook",
            "timeout": 10,
            "statusMessage": "Checking 3CAN GitHub PR guard"
          },
          {
            "type": "command",
            "command": "python scripts/3can_research_harness.py hook",
            "timeout": 10,
            "statusMessage": "Checking 3CAN research ledger"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/3can_research_harness.py hook",
            "timeout": 10,
            "statusMessage": "Checking 3CAN research completion"
          }
        ]
      }
    ]
  }
}
