{
  "description": "Restore active RuntimeHook intent and remind on due or stale semantic review.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run_runtimehook.sh\" --session-orientation",
            "commandWindows": "%SystemRoot%\\System32\\cmd.exe /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run_runtimehook.cmd\" -SessionOrientation\"",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run_runtimehook.sh\"",
            "commandWindows": "%SystemRoot%\\System32\\cmd.exe /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run_runtimehook.cmd\"\"",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|update_plan)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run_runtimehook.sh\"",
            "commandWindows": "%SystemRoot%\\System32\\cmd.exe /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run_runtimehook.cmd\"\"",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run_runtimehook.sh\"",
            "commandWindows": "%SystemRoot%\\System32\\cmd.exe /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run_runtimehook.cmd\"\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
