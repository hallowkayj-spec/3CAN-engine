THREECAN_BASE_URL=http://127.0.0.1:9711
THREECAN_ENGINE_ROOT=../3CAN-engine/neural-memory
THREECAN_GRAPH_DIR=../3CAN-engine/neural-memory/graph
THREECAN_PROJECT_DIR=.
# Additional ticket target roots, separated by the OS path separator
# (semicolon on Windows, colon on POSIX). Keep empty unless required.
THREECAN_TARGET_ROOTS=
THREECAN_MIN_NODES=10
# Fresh local projects start in development mode. Production mode additionally
# requires a pinned graph readiness profile.
THREECAN_READINESS_MODE=development
# Automatic ErrorCase resolution is fail-closed. Configure absolute evidence
# roots and inject a secret containing at least 32 random bytes at runtime.
# Never commit the real HMAC key.
THREECAN_EVIDENCE_ROOTS=
THREECAN_EVIDENCE_HMAC_KEY=
THREECAN_EVIDENCE_MAX_BYTES=4194304
THREECAN_TOKEN_AUTO_IMPORT=1
THREECAN_TOKEN_AUTO_IMPORT_INTERVAL=60
THREECAN_TOKEN_AUTO_IMPORT_MAX_FILES=3
THREECAN_TOKEN_AUTO_IMPORT_MAX_EVENTS=1000
